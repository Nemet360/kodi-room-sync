<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only the first category is meant to be used. `home_code` is normally written
  by the add-on's own pairing screen rather than typed here, but it is editable
  on purpose: a person who has the code and just reinstalled should be able to
  paste it in without being sent through a wizard.

  Everything in Advanced exists for somebody who wants to run their own ntfy
  instance or the Cloudflare Worker in server/worker.js. Nobody needs to touch
  it to use the add-on, which is the whole point.
-->
<settings version="1">
  <section id="plugin.video.roomwatchsync">
    <category id="home" label="30000">
      <group id="1">
        <setting id="home_code" type="string" label="30001">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>
        <setting id="device_id" type="string" label="30003">
          <level>0</level>
          <default>living-room</default>
          <constraints><allowempty>false</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>
        <setting id="rewind_seconds" type="integer" label="30005">
          <level>0</level>
          <default>20</default>
          <constraints><minimum>0</minimum><maximum>300</maximum></constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="notify_sync" type="boolean" label="30007">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="advanced" label="30010">
      <group id="1">
        <setting id="sync_mode" type="string" label="30011">
          <level>2</level>
          <default>ntfy</default>
          <constraints>
            <options>
              <option label="30012">ntfy</option>
              <option label="30013">url</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
        <setting id="ntfy_server" type="string" label="30014">
          <level>2</level>
          <default>https://ntfy.sh</default>
          <constraints><allowempty>false</allowempty></constraints>
          <dependencies>
            <dependency type="visible" setting="sync_mode" operator="is">ntfy</dependency>
          </dependencies>
          <control type="edit" format="string"/>
        </setting>
        <setting id="sync_url" type="string" label="30015">
          <level>2</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <dependencies>
            <dependency type="visible" setting="sync_mode" operator="is">url</dependency>
          </dependencies>
          <control type="edit" format="string"/>
        </setting>
        <setting id="poll_idle_seconds" type="integer" label="30016">
          <level>2</level>
          <default>60</default>
          <constraints><minimum>15</minimum><maximum>900</maximum></constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="poll_playing_seconds" type="integer" label="30017">
          <level>2</level>
          <default>600</default>
          <constraints><minimum>60</minimum><maximum>3600</maximum></constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
